---
// The app manifest, field by field, from the schema hlabs checks manifests with (US-SITE-07, D-147), and a real one.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import { manifestFields } from '../../../lib/manifest-reference';
import example from '../../../../../../store/apps/vaultwarden/hlabs-app.yml?raw';

const fields = manifestFields();
---

<StarlightPage
  frontmatter={{
    title: 'App manifest',
    description: 'Every field of hlabs-app.yml, the file that describes an app to hlabs, with its type and default.',
  }}
>
  <p>
    For people who package apps for hlabs. Each app in the store is a folder with a <code>docker-compose.yml</code>
    and an <code>hlabs-app.yml</code> that says what the app is, what it needs and how hlabs shows it. hlabs checks
    every manifest against this list before installing anything, so this page and hlabs always agree.
  </p>
  <h2 id="fields">Fields</h2>
  <table>
    <thead>
      <tr><th scope="col">Field</th><th scope="col">Type</th><th scope="col">Needed</th><th scope="col">Default</th></tr>
    </thead>
    <tbody>
      {
        fields.map((f) => (
          <tr>
            <td><code>{f.path}</code></td>
            <td>{f.type}{f.allowed ? <>: <code>{f.allowed}</code></> : null}</td>
            <td>{f.required ? 'Yes' : 'No'}</td>
            <td>{f.default ? <code>{f.default}</code> : '–'}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <h2 id="example">An example</h2>
  <p>Vaultwarden's manifest from the built-in store:</p>
  <Code code={example} lang="yaml" title="store/apps/vaultwarden/hlabs-app.yml" />
</StarlightPage>
