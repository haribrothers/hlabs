---
// Every message hlabs can show, by what it says (US-SITE-09, D-147).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { errorPages } from '../../../lib/errors';

const byTitle = [...errorPages].sort((a, b) => a.title.localeCompare(b.title));
---

<StarlightPage
  frontmatter={{ title: 'Error messages', description: 'Every message hlabs can show, and what to do about it.' }}
>
  <p>For everyone. Each message hlabs shows has a page that says what to do. When hlabs shows one, <strong>Learn more</strong> opens its page here.</p>
  <ul>
    {
      byTitle.map((e) => (
        <li>
          <a href={`/help/errors/${e.slug}/`}>{e.title}</a> <code>{e.code}</code>
        </li>
      ))
    }
  </ul>
</StarlightPage>
