---
// US-SITE-01: what hlabs is and what it needs, as drawn on the "Phase 6 · Website" canvas page (D-147).
import { Image } from 'astro:assets';
import AppTile from '../components/AppTile.astro';
import Icon from '../components/Icon.astro';
import Page from '../layouts/Page.astro';
import { siteReleases } from '../lib/releases';
import { storeApps } from '../lib/store';
import dockHome from '../assets/screens/DockHome.webp';

const apps = storeApps();
const releases = siteReleases();
const latest = releases.stable;
const installCommand = 'curl -fsSL https://hlabs.h4loom.com/install.sh | sh';

const steps = [
  {
    id: 'download',
    label: 'Download',
    title: 'Download hlabs',
    text: "On a Mac, open the disk image and drag hlabs into Applications. On a Linux server, run one command. If there's no container engine, hlabs sets one up for you.",
  },
  {
    id: 'set-up',
    label: 'Set up',
    title: 'Make your account in the browser',
    text: "hlabs opens a page on your own network. It checks the computer, then you name your hlabs and make the admin account. There's no account with us.",
  },
  {
    id: 'install',
    label: 'Install apps',
    title: 'Install apps in one click',
    text: 'Pick an app in the App Store. hlabs downloads it, gives it a folder for its data and an address of its own, and backs it up with everything else.',
  },
  {
    id: 'reach',
    label: 'Reach anywhere',
    title: 'Open your apps from anywhere',
    text: 'Turn on remote access with Tailscale and use your apps from your phone away from home, without opening ports on your router.',
  },
];
const app = (id: string) => apps.find((a) => a.id === id)!;
const featureApps = ['jellyfin', 'vaultwarden', 'mealie', 'adguard-home'].map(app).filter(Boolean);
---

<Page
  title="hlabs"
  description="hlabs turns a Mac or a Linux computer into a private cloud for your family: apps in one click, your files and backups, at home."
>
  <section class="hero">
    <div class="backdrop" aria-hidden="true">
      <div class="glow glow-coral drift-a" style="width: 560px; height: 560px; left: -140px; top: -200px"></div>
      <div class="glow glow-violet drift-b" style="width: 680px; height: 680px; right: -180px; top: -220px"></div>
      <div class="glow glow-teal drift-c" style="width: 760px; height: 520px; left: 50%; margin-left: -380px; top: 520px">
      </div>
      <div class="gridbg"></div>
    </div>
    <div class="wrap hero-text">
      {
        latest ? (
          <a href={`/releases/#${latest.version}`} class="announce rise">
            <span class="announce-tag">New</span>
            <span>What's new in hlabs {latest.version}</span>
            <Icon name="arrow-right" size={14} />
          </a>
        ) : (
          <a href="https://github.com/haribrothers/hlabs" class="announce rise">
            <span class="announce-tag">Soon</span>
            <span>hlabs is getting ready for its first release</span>
            <Icon name="arrow-right" size={14} />
          </a>
        )
      }
      <h1 class="hero-title rise rise-2">
        Your own cloud, <span class="underlined">at home<span class="draw" aria-hidden="true"></span></span>
      </h1>
      <p class="hero-lede rise rise-3">
        hlabs turns a Mac or a Linux computer into a private cloud for your family, with apps in one click, your files
        and backups, and nothing leaving the house unless you send it.
      </p>
      <div class="hero-actions rise rise-4">
        <a href="/download/" class="btn-primary">Download<Icon name="download" size={18} /></a>
        <a href="/help/" class="btn-secondary">Read the docs</a>
      </div>
      <p class="hero-small rise rise-4">Free and open source · macOS 14 or later · Ubuntu, Debian and Fedora</p>
    </div>

    <div class="shot-wrap">
      <div class="shot-persp">
        <figure class="shot tilt">
          <div class="shot-bar" aria-hidden="true">
            <span></span><span></span><span></span>
            <span class="mono shot-url">hlabs.local</span>
          </div>
          <Image
            src={dockHome}
            alt="hlabs Home on the Dusk wallpaper: app icons, the clock and usage widgets, and the Dock"
            widths={[720, 1040, 1440]}
            sizes="(max-width: 1120px) 92vw, 1040px"
            loading="eager"
            class="shot-img"
          />
        </figure>
        <div class="float float-left" aria-hidden="true">
          <div class="float-row">
            <span class="float-icon" style="background: var(--dock-backups)"><Icon name="history" size={18} /></span>
            <div>
              <div class="float-title">Backed up</div>
              <div class="float-sub">2 minutes ago · NAS and B2</div>
            </div>
          </div>
          <div class="bars">
            {[60, 72, 55, 80, 66, 90, 100].map((h) => <span style={`height: ${h}%`} />)}
          </div>
        </div>
        <div class="float float-right float-2" aria-hidden="true">
          <AppTile app={app('immich')} size={40} />
          <div style="flex: 1; min-width: 0">
            <div class="float-title">Immich is ready</div>
            <div class="float-sub"><span class="dot pulse"></span>Running · 2.1 GB</div>
          </div>
          <span class="pill" style="font-size: 12px">Open</span>
        </div>
      </div>
    </div>
  </section>

  <section class="reveal section-tight" aria-labelledby="appsTitle">
    <div class="wrap split-head">
      <div>
        <p class="eyebrow">The App Store</p>
        <h2 id="appsTitle" class="h2" style="font-size: clamp(28px, 3.2vw, 40px)">{apps.length} apps, one click each</h2>
      </div>
      <a href="/apps/" class="more">Browse all apps<Icon name="arrow-right" size={16} /></a>
    </div>
    <div class="marquee">
      <div class="marquee-track">
        <ul class="marquee-list">
          {
            apps.map((a) => (
              <li>
                <a href={`/apps/${a.id}/`} class="mq">
                  <AppTile app={a} size={44} />
                  <span class="mq-text">
                    <span class="mq-name">{a.name}</span>
                    <span class="mq-cat">{a.groupLabel}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        {/* The same row again so it loops; screen readers and Tab skip it, and Reduce motion hides it. */}
        <ul class="marquee-list marquee-dup" aria-hidden="true" inert>
          {
            apps.map((a) => (
              <li>
                <a href={`/apps/${a.id}/`} class="mq" tabindex="-1">
                  <AppTile app={a} size={44} />
                  <span class="mq-text">
                    <span class="mq-name">{a.name}</span>
                    <span class="mq-cat">{a.groupLabel}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="how" class="section" aria-labelledby="howTitle">
    <div class="wrap">
      <div class="split-head">
        <div style="max-width: 620px">
          <p class="eyebrow">How it works</p>
          <h2 id="howTitle" class="h2">From download to your first app in minutes</h2>
        </div>
        <p class="lede" style="max-width: 380px">
          Each step picks up where the last one left off. On a Mac you never open a terminal or edit a config file.
        </p>
      </div>
      <div class="rail-wrap" data-steps>
        <div class="rail" aria-hidden="true"><div class="rail-fill" data-rail-fill></div></div>
        <ol class="rail-dots">
          {
            steps.map((s, i) => (
              <li>
                <a href={`#step-${s.id}`} class="rail-dot" data-step-link={i} aria-current={i === 0 ? 'step' : undefined}>
                  <span class="rail-num">{i + 1}</span>
                  <span class="rail-label">{s.label}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="steps">
        {
          steps.map((s, i) => (
            <article id={`step-${s.id}`} class="step g-2" data-step={i}>
              <div>
                <p class="mono step-no">
                  0{i + 1} · {s.label}
                </p>
                <h3 class="step-title">{s.title}</h3>
                <p class="lede">{s.text}</p>
              </div>
              <div class="card step-card" aria-hidden="true">
                {s.id === 'download' && (
                  <div class="col">
                    <div class="kicker">Mac</div>
                    <div class="row">
                      <span class="row-icon"><Icon name="download" size={20} /></span>
                      <div style="flex: 1; min-width: 0">
                        <div class="mono ellipsis" style="font-size: 13px">hlabs-{latest?.version ?? '1.0.0'}-mac-arm64.dmg</div>
                        <div class="sub">Apple silicon</div>
                      </div>
                      <span class="ok"><Icon name="check" size={20} /></span>
                    </div>
                    <div class="kicker" style="margin-top: 6px">Linux server</div>
                    <div class="code"><div class="code-bar"><code><span class="prompt">$</span> {installCommand}</code></div></div>
                  </div>
                )}
                {s.id === 'set-up' && (
                  <div class="col">
                    <div class="card-title">Check this computer</div>
                    {[
                      ['Container engine', 'Colima, ready'],
                      ['Free space', '412 GB'],
                      ['Memory', '16 GB'],
                    ].map(([k, v]) => (
                      <div class="row">
                        <span class="ok"><Icon name="check" size={18} /></span>
                        <span style="flex: 1">{k}</span>
                        <span class="sub">{v}</span>
                      </div>
                    ))}
                    <div class="fake-field">Mehta home</div>
                  </div>
                )}
                {s.id === 'install' && (
                  <div class="col">
                    <div class="row" style="background: none; padding: 0">
                      <AppTile app={app('immich')} size={52} />
                      <div>
                        <div class="card-title">Installing Immich</div>
                        <div class="sub">Downloading · 1.2 of 1.9 GB</div>
                      </div>
                    </div>
                    <div class="progress"><div class="progress-fill"></div></div>
                    <div class="check-line"><span class="ok"><Icon name="check" size={16} /></span>Photo library folder: Home › Photos</div>
                    <div class="check-line"><span class="ok"><Icon name="check" size={16} /></span>Address: photos.hlabs.local</div>
                    <div class="check-line sub"><span class="ring"></span>Starting</div>
                  </div>
                )}
                {s.id === 'reach' && (
                  <div class="col">
                    <div class="row" style="background: none; padding: 0; justify-content: space-between">
                      <div class="card-title">Remote access</div>
                      <span class="pill"><span class="dot pulse"></span>On</span>
                    </div>
                    <div class="mono sub">mehta-home.tail0c4f.ts.net</div>
                    <div class="row"><Icon name="smartphone" size={18} /><span style="flex: 1">Asha's iPhone</span><span class="sub">Connected now</span></div>
                    <div class="row"><Icon name="laptop" size={18} /><span style="flex: 1">Ravi's laptop</span><span class="sub">Yesterday</span></div>
                    <div class="sub">No ports opened on your router.</div>
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="reveal section" aria-labelledby="insideTitle">
    <div class="wrap">
      <p class="eyebrow">What's inside</p>
      <h2 id="insideTitle" class="h2" style="max-width: 720px">Everything your family keeps, in one place you own</h2>
      <div class="bento">
        <article class="card card-h span-4 feature">
          <div>
            <h3>Apps in one click</h3>
            <p class="lede">Photos, films, passwords, recipes and more. Each app gets its own folder, address and backups.</p>
          </div>
          <ul class="mini-apps" aria-label="Some of the apps">
            {
              featureApps.map((a, i) => (
                <li class="row">
                  <AppTile app={a} size={40} />
                  <span style="flex: 1; font-weight: 700">{a.name}</span>
                  <span class="pill" aria-hidden="true" style="font-size: 12px">
                    {i < 2 ? 'Open' : 'Install'}
                  </span>
                </li>
              ))
            }
          </ul>
          <a href="/help/apps/app-store/" class="more push">Learn about the App Store<Icon name="arrow-right" size={16} /></a>
        </article>
        <article class="card card-h span-2 feature">
          <div>
            <h3>Your files</h3>
            <p class="lede">Upload, organise and share from any browser.</p>
          </div>
          <ul class="files" aria-hidden="true">
            {
              [
                ['Photos', '184 GB'],
                ['Documents', '6.2 GB'],
                ['Family', '22 GB'],
              ].map(([n, s]) => (
                <li>
                  <span class="folder"><Icon name="folder" size={20} /></span>
                  <span style="flex: 1">{n}</span>
                  <span class="sub">{s}</span>
                </li>
              ))
            }
          </ul>
          <a href="/help/files/files/" class="more push">Learn about Files<Icon name="arrow-right" size={16} /></a>
        </article>
        <article class="card card-h span-2 feature">
          <div>
            <h3>Backups that run themselves</h3>
            <p class="lede">Every night, encrypted, to a NAS, a drive or the cloud.</p>
          </div>
          <div class="nights" aria-hidden="true">
            {[50, 62, 48, 74, 58, 86].map((h) => <span style={`height: ${h}%`} />)}
            <span class="tonight"></span>
          </div>
          <div class="sub row-plain"><span>Last 6 nights: all backed up</span><span>Tonight 02:00</span></div>
          <a href="/help/backups/backups/" class="more push">Learn about backups<Icon name="arrow-right" size={16} /></a>
        </article>
        <article class="card card-h span-2 feature">
          <div>
            <h3>Reach it from anywhere</h3>
            <p class="lede">Your phone, away from home, through Tailscale. No open ports.</p>
          </div>
          <div class="chain" aria-hidden="true">
            <span class="chain-node"><Icon name="smartphone" size={22} /></span>
            <span class="dash"></span>
            <span class="pill" style="font-size: 12px">Tailscale</span>
            <span class="dash"></span>
            <span class="chain-node chain-home"><Icon name="house" size={22} /></span>
          </div>
          <a href="/help/remote-access/tailscale/" class="more push">Learn about remote access<Icon name="arrow-right" size={16} /></a>
        </article>
        <article class="card card-h span-2 feature">
          <div>
            <h3>Room for the family</h3>
            <p class="lede">Everyone gets their own login and only the apps you share.</p>
          </div>
          <ul class="people" aria-hidden="true">
            <li><span class="avatar" style="background: var(--chart-2)">A</span><span style="flex: 1; font-weight: 600">Asha</span><span class="sub">Admin</span></li>
            <li><span class="avatar" style="background: var(--chart-1)">R</span><span style="flex: 1; font-weight: 600">Ravi</span><span class="sub">4 apps</span></li>
            <li><span class="avatar" style="background: var(--chart-3)">M</span><span style="flex: 1; font-weight: 600">Mira</span><span class="sub">2 apps</span></li>
          </ul>
          <a href="/help/people/people/" class="more push">Learn about people<Icon name="arrow-right" size={16} /></a>
        </article>
      </div>
    </div>
  </section>

  <section class="reveal section" aria-labelledby="privTitle">
    <div class="wrap">
      <div class="card panel">
        <div class="gridbg panel-grid" aria-hidden="true"></div>
        <div style="position: relative">
          <p class="eyebrow">Private by design</p>
          <h2 id="privTitle" class="h2" style="max-width: 640px">Your data stays in your house</h2>
          <div class="g-3" style="margin-top: 44px">
            <div>
              <span class="feat-icon"><Icon name="user-round" size={22} /></span>
              <h3 class="feat-title">No account with us</h3>
              <p class="lede" style="font-size: 15px">
                You make the admin account on your own computer. We never see it, and there's nothing to sign up for.
              </p>
            </div>
            <div>
              <span class="feat-icon"><Icon name="eye-off" size={22} /></span>
              <h3 class="feat-title">No telemetry</h3>
              <p class="lede" style="font-size: 15px">
                hlabs sends no usage data. It only goes online to check for updates and download the apps you pick.
              </p>
            </div>
            <div>
              <span class="feat-icon"><Icon name="code" size={22} /></span>
              <h3 class="feat-title">Open source</h3>
              <p class="lede" style="font-size: 15px">
                Every line is on GitHub under AGPL-3.0. Read it, build it yourself, or help make it better.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="reveal section" aria-labelledby="needTitle">
    <div class="wrap">
      <p class="eyebrow">What you need</p>
      <h2 id="needTitle" class="h2">A computer you already have</h2>
      <div class="g-2" style="margin-top: 44px">
        <div class="card need">
          <div class="need-head"><Icon name="laptop" size={26} /><h3>Mac</h3></div>
          <dl>
            <div><dt>Chip</dt><dd>Apple silicon (Intel if the container engine runs on it)</dd></div>
            <div><dt>System</dt><dd>macOS 14 Sonoma or later</dd></div>
            <div><dt>Memory</dt><dd>8 GB recommended</dd></div>
          </dl>
        </div>
        <div class="card need">
          <div class="need-head"><Icon name="server" size={26} /><h3>Linux</h3></div>
          <dl>
            <div><dt>System</dt><dd>Ubuntu 22.04+, Debian 12+ or Fedora 40+, with systemd</dd></div>
            <div><dt>Processor</dt><dd>x86_64 or arm64</dd></div>
            <div><dt>Memory</dt><dd>8 GB recommended</dd></div>
          </dl>
        </div>
      </div>
      <p class="lede" style="margin-top: 20px; font-size: 15px">
        No container engine yet? hlabs sets one up for you.
      </p>
    </div>
  </section>

  <section class="reveal section section-last" aria-labelledby="installTitle">
    <div class="wrap">
      <div class="card panel">
        <div class="backdrop" aria-hidden="true">
          <div class="glow glow-violet drift-b" style="width: 520px; height: 420px; right: -120px; bottom: -200px"></div>
          <div class="glow glow-teal drift-c" style="width: 420px; height: 360px; right: 240px; bottom: -240px"></div>
        </div>
        <div class="g-2" style="position: relative; align-items: center; gap: 48px">
          <div>
            <h2 id="installTitle" class="h2" style="margin-top: 0">Install in a few minutes</h2>
            <p class="lede" style="margin-top: 18px; max-width: 440px">
              Download the Mac app, or run one command on a Linux server. The script checks the computer, installs
              Docker if it's missing and checks every download before it runs.
            </p>
            <div class="hero-actions" style="justify-content: flex-start">
              <a href="/download/" class="btn-primary">Download for Mac</a>
              <a href="/help/install/linux-server/" class="btn-secondary">Install guides</a>
            </div>
          </div>
          <div class="code terminal">
            <div class="terminal-bar">
              <span class="mono" style="font-size: 12px; color: var(--site-code-faint)">Linux server</span>
              {
                releases.installScript && (
                  <button type="button" class="copy-btn" data-copy={installCommand}>
                    <span class="done"><Icon name="check" size={14} /></span>
                    <span data-copy-label>Copy</span>
                    <span class="sr-only"> the install command</span>
                  </button>
                )
              }
            </div>
            <pre class="mono" tabindex="0" aria-label="What the install command prints"><code><span class="type t1"><span class="prompt">$</span> {installCommand}</span>
<span class="type t2 faint"><span class="okc">✓</span> Ubuntu 24.04 on x86_64 with systemd</span>
<span class="type t3 faint"><span class="okc">✓</span> Docker is installed</span>
<span class="type t4 faint"><span class="okc">✓</span> hlabs downloaded and checked</span>
<span class="type t5 faint"><span class="okc">✓</span> hlabs is running</span>
<span class="type t6">Open <span class="link">http://hlabs.local</span> to finish setting up<span class="caret" aria-hidden="true"></span></span></code></pre>
            {
              !releases.installScript && (
                <p class="terminal-note">The command works once the first release is out.</p>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  .hero {
    position: relative;
    padding: 96px 0 24px;
  }
  .hero-text {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .announce {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 14px 5px 5px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--site-line-2);
    background: var(--site-card);
    color: var(--site-ink) !important;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }
  .announce-tag {
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, var(--logo-coral), var(--logo-violet));
    color: var(--ink-on-light);
    font-size: 12px;
    font-weight: 800;
  }
  .hero-title {
    font-size: clamp(46px, 7.6vw, 92px);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 800;
    margin: 28px 0 0;
    max-width: 940px;
  }
  .underlined {
    position: relative;
    white-space: nowrap;
  }
  .draw {
    position: absolute;
    left: 1%;
    right: 1%;
    bottom: -0.04em;
    height: 0.08em;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, var(--logo-coral), var(--logo-violet) 50%, var(--logo-teal));
    transform-origin: left center;
  }
  .hero-lede {
    font-size: clamp(17px, 1.7vw, 20px);
    line-height: 1.55;
    color: var(--site-muted);
    max-width: 660px;
    margin: 28px 0 0;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 36px;
  }
  .hero-small {
    font-size: 13px;
    color: var(--site-faint);
    margin: 18px 0 0;
  }
  .shot-wrap {
    position: relative;
    margin-top: 72px;
    display: flex;
    justify-content: center;
    padding: 0 16px;
  }
  .shot-persp {
    perspective: 2200px;
    position: relative;
    width: min(1040px, 100%);
  }
  .shot {
    margin: 0;
    transform-origin: 50% 0;
    border-radius: 18px;
    border: 1px solid var(--site-line-2);
    background: var(--site-bg-2);
    box-shadow: 0 50px 120px rgba(8, 4, 30, 0.55);
    overflow: hidden;
  }
  .shot-bar {
    height: 36px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 14px;
    border-bottom: 1px solid var(--site-line);
    background: var(--site-card-2);
  }
  .shot-bar > span:not(.shot-url) {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--site-line-2);
  }
  .shot-url {
    margin: 0 auto;
    padding: 3px 14px;
    border-radius: var(--radius-xs);
    background: var(--site-control);
    font-size: 12px;
    color: var(--site-faint);
  }
  .shot-img {
    display: block;
    width: 100%;
    height: auto;
  }
  .float {
    position: absolute;
    padding: 16px;
