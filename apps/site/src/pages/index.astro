<script>
  // The steps follow the page (Spine-style): the one in view is the current step on the rail. Without JavaScript
  // every step is simply there, one after another.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-step-link]')];
  const fill = document.querySelector<HTMLElement>('[data-rail-fill]');
  const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
  const show = (n: number) => {
    links.forEach((l, i) => {
      if (i === n) l.setAttribute('aria-current', 'step');
      else l.removeAttribute('aria-current');
      l.toggleAttribute('data-done', i < n);
    });
    if (fill) fill.style.width = `${(n / (links.length - 1)) * 100}%`;
  };
  // The current step is the last one whose top has passed the middle of the window, however fast the page scrolls.
  let queued = false;
  const update = () => {
    queued = false;
    const middle = window.innerHeight / 2;
    let current = 0;
    steps.forEach((s, i) => {
      if (s.getBoundingClientRect().top < middle) current = i;
    });
    show(current);
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  update();
</script>
