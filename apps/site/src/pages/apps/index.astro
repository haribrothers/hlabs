---
// US-SITE-03: every app in the built-in store, grouped as the store groups them, from store/ (D-147).
import AppTile from '../../components/AppTile.astro';
import Icon from '../../components/Icon.astro';
import Page from '../../layouts/Page.astro';
import { storeApps, storeGroups } from '../../lib/store';

const apps = storeApps();
const groups = storeGroups();
const featured = apps.filter((a) => a.featured);
const count = (n: number) => (n === 1 ? '1 app' : `${n} apps`);
---

<Page
  title="Apps"
  current="apps"
  description={`${apps.length} open-source apps you can install on hlabs in one click: photos, films, passwords, smart home and more.`}
>
  <section class="page-head">
    <div class="backdrop" aria-hidden="true">
      <div class="glow glow-coral drift-a" style="width: 520px; height: 520px; left: -160px; top: -260px"></div>
      <div class="glow glow-teal drift-b" style="width: 640px; height: 600px; right: -200px; top: -280px"></div>
      <div class="gridbg"></div>
    </div>
    <div class="wrap" style="position: relative">
      <p class="eyebrow rise">Apps</p>
      <h1 class="h1 rise rise-2" style="max-width: 760px">Apps for your hlabs</h1>
      <p class="lede rise rise-3" style="font-size: 18px; margin-top: 18px; max-width: 640px">
        {apps.length} open-source apps, each installed in one click from the App Store in your dashboard. They run on your
        computer and keep their data in your folders.
      </p>
    </div>
  </section>

  <div class="chips-bar">
    <div class="wrap">
      <nav class="chips" aria-label="Categories">
        <a class="chip" href="/apps/" data-category="" aria-current="true">All apps</a>
        {
          groups.map((g) => (
            <a class="chip" href={`/apps/?category=${g.id}`} data-category={g.id}>
              {g.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  {
    featured.length > 0 && (
      <section class="featured pop" aria-labelledby="featTitle" data-featured>
        <div class="wrap">
          <h2 id="featTitle" class="small-head">
            Featured
          </h2>
          <div class="feat">
            {featured.map((a, i) => (
              <a href={`/apps/${a.id}/`} class={`feat-card feat-${i % 2}`}>
                <AppTile app={a} size={60} />
                <div class="feat-text">
                  <div class="feat-name">{a.name}</div>
                  <div class="feat-tag">{a.tagline}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="all" aria-label="All apps">
    <div class="wrap groups">
      {
        groups.map((g) => (
          <section class="group pop" aria-labelledby={`g-${g.id}`} data-group={g.id}>
            <div class="group-head">
              <h2 id={`g-${g.id}`}>{g.label}</h2>
              <span class="faint">{count(g.apps.length)}</span>
            </div>
            <ul class="apps">
              {g.apps.map((a) => (
                <li>
                  <a href={`/apps/${a.id}/`} class="app">
                    <AppTile app={a} size={52} />
                    <span class="app-text">
                      <span class="app-name">{a.name}</span>
                      <span class="app-tag">{a.tagline}</span>
                      <span class="app-meta">
                        {a.developer.name}
                        {a.license && ` · ${a.license}`}
                      </span>
                      {a.badges.length > 0 && (
                        <span class="badges">
                          {a.badges.map((b) => (
                            <span class="badge">{b}</span>
                          ))}
                        </span>
                      )}
                    </span>
                    <span class="chev">
                      <Icon name="chevron-right" size={18} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <section class="own" aria-labelledby="ownTitle">
    <div class="wrap">
      <div class="card own-card">
        <div style="max-width: 640px">
          <h2 id="ownTitle">Missing an app?</h2>
          <p class="lede" style="font-size: 15px">
            Admins can add another app source to the App Store. Each app's files are checked before anything runs.
          </p>
        </div>
        <a href="/help/apps/app-store/" class="btn-secondary btn-sm">About app sources</a>
      </div>
    </div>
  </section>
</Page>

<script>
  // Category chips (US-SITE-03): only that category's apps, and the address says which, so it can be shared.
  const chips = [...document.querySelectorAll<HTMLAnchorElement>('[data-category]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  const featured = document.querySelector<HTMLElement>('[data-featured]');
  const show = (category: string) => {
    const known = groups.some((g) => g.dataset.group === category);
    const pick = known ? category : '';
    chips.forEach((c) => c.setAttribute('aria-current', String(c.dataset.category === pick)));
    groups.forEach((g) => (g.hidden = pick !== '' && g.dataset.group !== pick));
    if (featured) featured.hidden = pick !== '';
  };
  chips.forEach((c) =>
    c.addEventListener('click', (e) => {
      e.preventDefault();
      const category = c.dataset.category ?? '';
      history.pushState(null, '', category ? `/apps/?category=${category}` : '/apps/');
      show(category);
    }),
  );
  const read = () => show(new URLSearchParams(location.search).get('category') ?? '');
  window.addEventListener('popstate', read);
  read();
</script>

<style>
  /* Below the top bar and the category bar too. */
  :global(html) {
    scroll-padding-top: 150px;
  }
  .chips-bar {
    position: sticky;
    top: 64px;
    z-index: 10;
    background: var(--site-nav);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--site-line);
  }
  .chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 14px 0;
    scrollbar-width: none;
  }
  .featured {
    padding: 40px 0 8px;
  }
  .small-head {
    font-size: 14px;
    font-weight: 700;
    color: var(--site-faint);
    margin: 0 0 16px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .feat {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .feat-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28px;
    min-height: 220px;
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: var(--ink) !important;
    box-shadow: var(--site-shadow);
    transition: transform 0.25s ease;
  }
  .feat-card:hover {
    transform: translateY(-2px);
  }
  .feat-0 {
    background:
      radial-gradient(120% 120% at 0% 0%, var(--wall-coral) 0%, transparent 55%),
      radial-gradient(120% 120% at 100% 100%, var(--wall-violet) 0%, transparent 60%),
      var(--wall-base);
  }
  .feat-1 {
    background:
      radial-gradient(120% 120% at 100% 0%, var(--wall-teal) 0%, transparent 55%),
      radial-gradient(120% 120% at 0% 100%, var(--accent-strong) 0%, transparent 60%),
      var(--wall-base);
  }
  .feat-text {
    margin-top: auto;
  }
  .feat-name {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .feat-tag {
    font-size: 16px;
    color: var(--ink-muted);
    margin-top: 6px;
  }
  .all {
    padding: 24px 0 64px;
  }
  .groups {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .group-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 14px;
  }
  .group-head h2 {
    font-size: 22px;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .faint {
    color: var(--site-faint);
    font-size: 14px;
  }
  .apps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .apps li {
    display: flex;
  }
  .apps .app {
    flex: 1;
  }
  .app-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    flex: 1;
  }
  .app-name {
    font-size: 17px;
    font-weight: 700;
  }
  .app-tag {
    font-size: 14px;
    line-height: 1.5;
    color: var(--site-muted);
  }
  .app-meta {
    font-size: 12px;
    color: var(--site-faint);
    margin-top: 4px;
  }
  .badges {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .chev {
    color: var(--site-faint);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .own {
    padding: 24px 0 112px;
  }
  .own-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 32px;
  }
  .own-card h2 {
    font-size: 22px;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  @media (max-width: 980px) {
    .apps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .apps,
    .feat {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
