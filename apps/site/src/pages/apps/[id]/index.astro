---
// US-SITE-04: an app's page, from its manifest in store/ (D-147). Installing happens in the dashboard: the site never
// talks to anyone's hlabs.
import AppTile from '../../../components/AppTile.astro';
import Icon from '../../../components/Icon.astro';
import Page from '../../../layouts/Page.astro';
import { storeApps, type StoreApp } from '../../../lib/store';

export function getStaticPaths() {
  return storeApps().map((app) => ({ params: { id: app.id }, props: { app } }));
}

interface Props {
  app: StoreApp;
}
const { app } = Astro.props;
const related = storeApps()
  .filter((a) => a.group === app.group && a.id !== app.id)
  .slice(0, 3);
---

<Page title={app.name} current="apps" description={`${app.name}: ${app.tagline}. Install it on hlabs in one click.`}>
  <section class="head">
    <div class="backdrop" aria-hidden="true">
      <div
        class="glow drift-b"
        style={`width: 620px; height: 460px; right: -220px; top: -320px; background: ${app.gradient?.[0] ?? 'var(--wall-violet)'}; opacity: calc(var(--site-glow) * 0.35)`}
      >
      </div>
    </div>
    <div class="wrap" style="position: relative">
      <nav aria-label="Breadcrumb" class="crumbs">
        <a href="/apps/">Apps</a>
        <span aria-hidden="true">›</span>
        <a href={`/apps/?category=${app.group}`}>{app.groupLabel}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{app.name}</span>
      </nav>
      <div class="title rise">
        <AppTile app={app} size={112} />
        <div style="flex: 1; min-width: 0">
          <h1 class="app-h1">{app.name}</h1>
          <p class="lede" style="font-size: 18px; margin-top: 8px">{app.tagline}</p>
          <ul class="pills" aria-label="About this app">
            <li class="pill">{app.groupLabel}</li>
            <li class="pill">By {app.developer.name}</li>
            {app.license && <li class="pill">{app.license}</li>}
            <li class="pill">Version {app.version}</li>
            {app.badges.map((b) => <li class="pill">{b}</li>)}
          </ul>
        </div>
        <a href="#install" class="btn-primary">How to install</a>
      </div>
    </div>
  </section>

  <section class="body">
    <div class="wrap layout">
      <div class="main">
        {
          app.screenshots.length > 0 && (
            <section aria-label="Screenshots" class="shots rise rise-2">
              {app.screenshots.map((s, i) => (
                <a href={s.url} class="shot">
                  <img
                    src={s.url}
                    alt={`${app.name}, screenshot ${i + 1} of ${app.screenshots.length}`}
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </a>
              ))}
            </section>
          )
        }

        <section aria-labelledby="aboutTitle">
          <h2 id="aboutTitle" class="h-sec">About {app.name}</h2>
          {app.description.map((p) => <p class="about">{p}</p>)}
          <div class="links">
            {
              app.website && (
                <a href={app.website} class="more">
                  Website
                  <Icon name="arrow-up-right" size={14} />
                </a>
              )
            }
            {
              app.source && (
                <a href={app.source} class="more">
                  Source code
                  <Icon name="arrow-up-right" size={14} />
                </a>
              )
            }
          </div>
        </section>

        <section aria-labelledby="needTitle" class="card needs">
          <h2 id="needTitle" class="h-sec" style="margin-bottom: 8px">What it needs</h2>
          <ul>
            {
              app.needs.map((n) => (
                <li>
                  <span class="need-icon">
                    <Icon name={n.icon} size={22} />
                  </span>
                  <div>
                    <div class="need-title">{n.title}</div>
                    {n.detail && <div class="need-detail">{n.detail}</div>}
                  </div>
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <aside class="aside">
        <section id="install" aria-labelledby="installTitle" class="card box">
          <h2 id="installTitle" class="box-title">Install {app.name}</h2>
          <p class="box-text">Open the App Store in your hlabs dashboard and search for {app.name}.</p>
          <ol class="how">
            <li><span class="n">1</span><span>Open <strong>App Store</strong> in the Dock</span></li>
            <li><span class="n">2</span><span>Search for <strong>{app.name}</strong></span></li>
            <li><span class="n">3</span><span>Click <strong>Install</strong></span></li>
          </ol>
          <div class="box-actions">
            <a href="/help/apps/app-store/" class="btn-secondary btn-sm">How to install apps</a>
            <a href="/download/" class="center-link">Don't have hlabs yet? Download it</a>
          </div>
          <p class="box-small">This site never talks to your hlabs.</p>
        </section>
        {
          related.length > 0 && (
            <section aria-labelledby="moreTitle" class="card box">
              <h2 id="moreTitle" class="box-title" style="font-size: 15px">
                More in {app.groupLabel}
              </h2>
              <ul class="related">
                {related.map((r) => (
                  <li>
                    <a href={`/apps/${r.id}/`}>
                      <AppTile app={r} size={40} />
                      <span>
                        <span class="r-name">{r.name}</span>
                        <span class="r-tag">{r.tagline}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>
    </div>
  </section>
</Page>

<style>
  .head {
    position: relative;
    padding: 40px 0 32px;
  }
  .crumbs {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--site-faint);
  }
  .title {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 28px;
  }
  .app-h1 {
    font-size: clamp(38px, 5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 800;
    margin: 0;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .body {
    padding: 8px 0 112px;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 40px;
    align-items: start;
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 40px;
    min-width: 0;
  }
  .shots {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 6px;
  }
  .shot {
    flex: 0 0 min(560px, 88%);
    scroll-snap-align: start;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--site-line-2);
    box-shadow: var(--site-shadow);
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .h-sec {
    font-size: 24px;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  .about {
    font-size: 17px;
    line-height: 1.7;
    color: var(--site-muted);
    margin: 0 0 12px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 6px;
  }
  .needs {
    padding: 28px;
  }
  .needs ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .needs li {
    display: flex;
    gap: 14px;
    padding: 16px 0;
    border-top: 1px solid var(--site-line);
  }
  .need-icon {
    flex-shrink: 0;
    display: inline-flex;
  }
  .need-title {
    font-weight: 700;
  }
  .need-detail {
    font-size: 14px;
    color: var(--site-muted);
    margin-top: 2px;
    line-height: 1.5;
  }
  .aside {
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .box {
    padding: 26px;
  }
  .box-title {
    font-size: 20px;
    letter-spacing: -0.02em;
    margin: 0 0 6px;
  }
  .box-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--site-muted);
    margin: 0 0 18px;
  }
  .how {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 14px;
  }
  .how li {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .n {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--site-control);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 800;
    flex-shrink: 0;
  }
  .box-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 22px;
  }
  .center-link {
    text-align: center;
    font-size: 14px;
    font-weight: 600;
  }
  .box-small {
    font-size: 12px;
    color: var(--site-faint);
    margin: 18px 0 0;
  }
  .related {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .related a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    text-decoration: none;
    color: var(--site-ink) !important;
  }
  .r-name {
    display: block;
    font-size: 14px;
    font-weight: 700;
  }
  .r-tag {
    font-size: 12px;
    color: var(--site-faint);
  }
  @media (max-width: 980px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .aside {
      position: static;
    }
  }
  @media (max-width: 720px) {
    .title {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
