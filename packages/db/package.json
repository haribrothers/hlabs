{
  "name": "@hlabs/db",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./settings": "./src/settings.ts"
  },
  "files": [
    "src",
    "migrations"
  ],
  "scripts": {
